# --- Firebase, browser half (the /studio door only) -------------------------
# Firebase console → Project settings → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Firebase, server half (reads articles, verifies the writer) ------------
# Firebase console → Project settings → Service accounts → Generate new key.
# Paste the private key on one line, keeping the \n sequences as they are.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The one account allowed to write. Firebase console → Authentication → Users.
ADMIN_UID=
