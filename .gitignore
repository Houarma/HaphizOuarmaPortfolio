# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build
next-env.d.ts

# secrets — never commit these
.env
.env.*
!.env.example
*-firebase-adminsdk-*.json
serviceAccountKey.json

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo

# Source images stay on the machine that shot them. The site serves the
# optimised WebP sitting next to each one; keeping the originals here would
# put ~70 MB in the history for ever. Delete these six lines to include them.
public/media/*.png
public/media/prod/IMG_*
public/media/project/*.png
public/media/project/*.jpeg
public/media/books/*.png
public/media/Blogs/*.jpeg
